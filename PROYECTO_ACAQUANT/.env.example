# Copiá este archivo a `.env` y completalo. `.env` NO se sube al repo.

# --- Modelo: API key gratuita de Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=tu-api-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE
# ADK_MODEL=gemini-2.5-flash

# --- Datos: AcaQuant como proveedor
# fixtures = captura real guardada en puente/fixtures (sin red ni login)  [default]
# mcp      = en vivo contra https://api.acaquant.com/mcp (login de Cloudflare Access en el navegador)
ACAQUANT_MODO=fixtures
# ACAQUANT_OAUTH_PUERTO=8765
